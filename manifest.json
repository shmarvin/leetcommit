{
  "manifest_version": 3,
  "name": "LeetCommit",
  "version": "0.1.0",
  "description": "Capture a LeetCode submission, review it, and commit it to GitHub.",
  "permissions": ["storage", "activeTab", "scripting", "declarativeContent", "alarms"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "LeetCommit"}
}
